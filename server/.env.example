MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=hardware-library
# Base name for the four databases; also the default legacy migration source.
MONGODB_DATABASE=HardwareLibrary
# Optional overrides. These four database names must be different.
# MONGODB_USERS_DATABASE=HardwareLibrary_users
# MONGODB_HARDWARE_DATABASE=HardwareLibrary_hardware
# MONGODB_PROJECTS_DATABASE=HardwareLibrary_projects
# MONGODB_HISTORY_DATABASE=HardwareLibrary_history
# Generate a random value: python3 -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
